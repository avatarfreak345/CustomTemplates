App.LinuxCommandLineArgs=
App.Ports=@IncludeJson[moon-sweeperports.json]
App.UpdateSources=@IncludeJson[moon-sweeperupdates.json]
App.EnvironmentVariables={"MOON_SERVER_PASSWORD":"{{MoonPassword}}","MOON_ALLOWED_STEAM_IDS":"{{MoonAllowedIDs}}","MOON_SLOT":"{{MoonSlot}}","MOON_GAME_PORT":"{{MoonGamePort}}","MOON_QUERY_PORT":"{{MoonQueryPort}}","MOON_BACKUP_KEEP":"{{MoonBackups}}","TZ":"{{MoonTimezone}}"}