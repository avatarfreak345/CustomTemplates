Meta.MinAMPVersion=2.4.6.6
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=True
Meta.ContainerPolicy=RequiredOnLinux
Meta.ContainerPolicyReason=Requires a custom Docker environment with Wine and Steam GameServer dependencies
